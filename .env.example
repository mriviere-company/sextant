# Copy to .env (git-ignored).

# LLM providers (generation, question generation, LLM judge). Set at least one.
# Phase 1 (`make candidates`) uses DeepSeek; a run that only replays the cache needs a dummy value.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Vector store (phase 2): PostgreSQL with the pgvector extension (`make db-up`).
DATABASE_URL=postgresql://sextant:sextant@127.0.0.1:5432/sextant
# Disposable database for integration tests (they truncate tables). Never the one above.
TEST_DATABASE_URL=postgresql://sextant:sextant@127.0.0.1:5432/sextant_test

# HTTP API (phase 3). Defaults are in docs/generation.md; everything below is optional.
# Which LLM answers: fake (offline, no key), deepseek (DEEPSEEK_API_KEY) or anthropic
# (ANTHROPIC_API_KEY, resolved by the SDK). SEXTANT_LLM_MODEL overrides the provider default.
SEXTANT_LLM_PROVIDER=fake
SEXTANT_LLM_MODEL=
# Whole-request time budget in seconds, and max tokens of the model's answer.
SEXTANT_REQUEST_TIMEOUT_S=20
SEXTANT_MAX_OUTPUT_TOKENS=600
# Daily LLM spend cap in USD (in process, reset at 00:00 UTC), then 503 `unavailable`.
SEXTANT_DAILY_BUDGET_USD=1.00
# Rate limits per client address, requests per minute.
SEXTANT_ASK_PER_MINUTE=10
SEXTANT_SEARCH_PER_MINUTE=60
# Set to 1 only behind a reverse proxy: count clients by X-Forwarded-For.
SEXTANT_TRUST_PROXY=0
