# Copy to .env (git-ignored). Nothing here is needed before phase 1.

# LLM providers (generation, question generation, LLM judge). Set at least one.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Vector store (phase 2): PostgreSQL with the pgvector extension (`make db-up`).
DATABASE_URL=postgresql://sextant:sextant@127.0.0.1:5432/sextant
# Disposable database for integration tests (they truncate tables). Never the one above.
TEST_DATABASE_URL=postgresql://sextant:sextant@127.0.0.1:5432/sextant_test
